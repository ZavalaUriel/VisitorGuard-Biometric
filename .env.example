
################################
# VisitorGuard Configuration File #
################################

# ==================== CONFIGURACIÓN DE FLASK ====================
SECRET_KEY=your-secret-key-here
FLASK_ENV=development

# ==================== CONFIGURACIÓN DE LA BASE DE DATOS ====================
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=admin123
MONGO_DATABASE=visitorguard

# ==================== CONFIGURACIÓN DE EMAIL (Flask-Mail) ====================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=tu-email@gmail.com
MAIL_PASSWORD=tu-password-de-aplicacion

# ==================== CONFIGURACIÓN DE DOMINIO (Para SSL) ====================
DOMAIN=deepface.zukdev.com
SSL_EMAIL=tu-email@ejemplo.com

# ==================== MONGO EXPRESS (Interfaz Web para MongoDB) ====================
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=admin123

################################################
# Server Configuration
################################################

PORT=5000
##################################################
# DeepFace Configuration
# Modelos disponibles: VGG-Face, Facenet, Facenet512, OpenFace, DeepFace, DeepID, ArcFace, Dlib, SFace
################################################

FACE_MODEL=Facenet

################################################
# Métricas disponibles: cosine, euclidean, euclidean_l2
################################################

FACE_DISTANCE_METRIC=cosine

###############################################
# CORS Configuration (URLs permitidas, separadas por comas)
###############################################

CORS_ORIGINS=http://localhost:3000,http://localhost:8000


###############################################
# Email Configuration 
###############################################

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_contraseña_de_aplicación
FRONTEND_URL=http://localhost:3000/completar-registro